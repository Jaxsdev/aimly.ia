# Variables de entorno — Web (apps/web)

VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_PORTAL_PUBLIC_KEY=pk_your_publishable_key

# Optional but recommended for calls between restrictive networks/mobile data.
